<Application x:Class="ClipAssist.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 默认先加载浅色；ThemeService 启动时会在同一个位置替换为保存的主题。
                 颜色字典必须在样式字典之前，保证 StaticResource 样式加载时能找到 Brush。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ThemeColors.Light.xaml" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- bool -> Visibility 的转换器，WPF 自带，用于“列表为空”提示 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
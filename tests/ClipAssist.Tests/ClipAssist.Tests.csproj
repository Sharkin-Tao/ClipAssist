<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipAssist.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ClipAssist.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 主题颜色字典随测试输出复制，单元测试直接检查实际颜色值。 -->
    <None Include="..\..\Styles\ThemeColors.*.xaml"
          Link="Styles\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 主项目移除了 WinForms 隐式 using，这里保持一致，避免 Application 等类型歧义 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
<Window x:Class="ClipAssist.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipAssist.Controls"
        Title="剪贴板浮窗"
        Width="300"
        Height="320"
        MinWidth="260"
        MinHeight="240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="FloatingWindow">

    <!-- 精简浮窗：只保留搜索和历史列表，不放置主窗口的操作按钮或标题区。 -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="32"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemeTextBoxStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             AutomationProperties.AutomationId="FloatingSearchBox"
                             AutomationProperties.Name="搜索历史记录" />

                    <TextBlock Text="搜索历史记录…"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button x:Name="ExpandButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Margin="3,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="打开完整窗口"
                        Click="OnExpandClick"
                        AutomationProperties.AutomationId="ExpandToMainWindow"
                        AutomationProperties.Name="打开完整窗口">
                    <Viewbox Width="11" Height="11">
                        <Path Data="M 1.5,4.5 L 1.5,1.5 L 4.5,1.5 M 7.5,1.5 L 10.5,1.5 L 10.5,4.5 M 10.5,7.5 L 10.5,10.5 L 7.5,10.5 M 4.5,10.5 L 1.5,10.5 L 1.5,7.5"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="3">
            <Grid>
                <ListBox x:Name="HistoryList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Style="{StaticResource HistoryListBoxStyle}"
                         PreviewMouseLeftButtonDown="OnHistoryListPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnHistoryListPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnHistoryListPreviewMouseLeftButtonUp"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="FloatingHistoryList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource HistoryItemStyle}">
                            <Setter Property="Padding" Value="7,5" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:HighlightTextBlock Grid.Column="0"
                                                            SourceText="{Binding Preview}"
                                                            SearchText="{Binding DataContext.SearchText,
                                                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            HighlightBrush="{DynamicResource SearchHighlightBrush}"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding Text}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimeText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="6,0,2,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyHintText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="8"
                           Visibility="{Binding IsListEmpty, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
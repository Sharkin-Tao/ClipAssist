<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘用 WinForms 的 NotifyIcon；Windows Desktop SDK 自带，不需要额外 NuGet -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipAssist</RootNamespace>
    <AssemblyName>ClipAssist</AssemblyName>
    <ApplicationIcon>Assets\ClipAssist.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 是 WinForms 分析器的建议；本项目是 WPF，DPI 感知必须在进程启动前
         由 app.manifest 声明，不能等到 Application.SetHighDpiMode。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
    <Product>ClipAssist</Product>
    <AssemblyTitle>ClipAssist</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests 是独立测试工程；主工程不能把它的源码和 obj 生成文件一起编译 -->
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <ApplicationDefinition Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 去掉 WinForms 的隐式 using，避免 Application / MessageBox 等与 WPF 重名冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标从输出目录加载，因此需要随生成复制 -->
    <Content Include="Assets\ClipAssist.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
<Window x:Class="ClipAssist.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipAssist.Localization"
        Title="ClipAssist"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmDialogHeading" />

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   FontSize="12"
                   LineHeight="19"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ConfirmDialogMessage" />

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="{loc:Loc Common.Cancel}"
                    Width="84"
                    Height="32"
                    Padding="16,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.AutomationId="ConfirmDialogCancel"
                    AutomationProperties.Name="{loc:Loc Common.Cancel}" />
            <Button x:Name="ConfirmButton"
                    Content="{loc:Loc Common.Delete}"
                    Width="96"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="16,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="OnConfirmClick"
                    AutomationProperties.AutomationId="ConfirmDialogConfirm"
                    AutomationProperties.Name="{loc:Loc Common.Delete}" />
        </StackPanel>
    </Grid>
</Window>
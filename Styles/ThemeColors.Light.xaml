<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：Windows 11 浅色近似值。只放颜色，控件样式在 Theme.xaml。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A7BD1" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005BA1" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#F8D7DA" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="#FFE58F" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#CCE4F9" />
    <SolidColorBrush x:Key="TextSelectionTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D0D0D0" />

</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：Windows 11 深色近似值。强调色分成“填充”和“文字”两种，
         避免把浅蓝用在白字按钮上造成对比度不足。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B88D8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0A5694" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#4A2428" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#5E2C31" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#264F78" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="#6A4E00" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="TextSelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4A4A4A" />

</ResourceDictionary>
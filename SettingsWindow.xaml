<Window x:Class="ClipAssist.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="460"
        SizeToContent="Height"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="外观"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="ThemeSelector"
                      Width="180"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource ThemeComboBoxStyle}"
                      SelectionChanged="OnThemeSelectionChanged"
                      AutomationProperties.AutomationId="ThemeSelector"
                      AutomationProperties.Name="主题" />
            <TextBlock Text="主题选择会立即生效并保存；跟随系统时随 Windows 应用主题切换。"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="启动"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <CheckBox x:Name="StartupCheckBox"
                      Margin="0,8,0,0"
                      Content="开机自启动"
                      FontSize="13"
                      Style="{StaticResource ThemeCheckBoxStyle}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="OnStartupOptionChanged"
                      Unchecked="OnStartupOptionChanged"
                      AutomationProperties.AutomationId="StartupWithWindows"
                      AutomationProperties.Name="开机自启动" />
            <TextBlock Text="开启后，登录 Windows 时自动启动 ClipAssist。"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="StartupStatusText"
                       Margin="0,5,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="全局快捷键"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="EffectiveText"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SavedText"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Margin="0,3,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="新的快捷键"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="CaptureButton"
                    Height="46"
                    Margin="0,6,0,0"
                    Padding="12,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource HotkeyCaptureButtonStyle}"
                    Click="OnCaptureClick"
                    AutomationProperties.AutomationId="HotkeyCapture"
                    AutomationProperties.Name="快捷键录入">
                <TextBlock x:Name="CaptureText"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <TextBlock Text="点击上方框后按下组合键；再次点击或按 Esc 取消录入。若组合已被其他程序占用、按键收不到，可在下方直接输入。"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="或手动输入"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ManualGestureBox"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         Style="{StaticResource ThemeTextBoxStyle}"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         KeyDown="OnManualKeyDown"
                         AutomationProperties.AutomationId="HotkeyManualInput"
                         AutomationProperties.Name="手动输入快捷键" />
                <Button x:Name="ApplyManualButton"
                        Grid.Column="1"
                        Content="应用"
                        Margin="8,0,0,0"
                        MinWidth="56"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnApplyManualClick"
                        AutomationProperties.AutomationId="HotkeyManualApply" />
            </Grid>
        </StackPanel>

        <CheckBox x:Name="SelectSearchTextCheckBox"
                  Grid.Row="5"
                  Margin="0,16,0,0"
                  Content="呼出窗口时全选搜索框已有文字"
                  FontSize="12"
                  Style="{StaticResource ThemeCheckBoxStyle}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  AutomationProperties.AutomationId="SelectSearchTextOnActivate"
                  AutomationProperties.Name="呼出时全选搜索框文字" />

        <StackPanel Grid.Row="6" Margin="0,18,0,0">
            <TextBlock Text="数据存储"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="当前数据目录"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StoragePathBox"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         HorizontalScrollBarVisibility="Auto"
                         Style="{StaticResource ThemeTextBoxStyle}"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         AutomationProperties.AutomationId="DataDirectoryPath"
                         AutomationProperties.Name="当前数据目录" />
                <Button x:Name="StorageChangeButton"
                        Grid.Column="1"
                        Content="更改…"
                        Margin="8,0,0,0"
                        MinWidth="72"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnStorageClick"
                        AutomationProperties.AutomationId="ChangeDataDirectory"
                        AutomationProperties.Name="更改数据目录" />
            </Grid>
            <TextBlock x:Name="StorageHintText"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="7"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" />

        <Grid Grid.Row="8" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="RestoreDefaultButton"
                    Content="恢复默认"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="84"
                    Click="OnRestoreDefaultClick" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="72"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button x:Name="SaveButton"
                        Content="保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
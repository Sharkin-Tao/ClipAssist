<Window x:Class="ClipAssist.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipAssist.Localization"
        Title="{loc:Loc Settings.Title}"
        Width="460"
        SizeToContent="Height"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Settings.Language}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="LanguageSelector"
                      Width="180"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource ThemeComboBoxStyle}"
                      SelectionChanged="OnLanguageSelectionChanged"
                      AutomationProperties.AutomationId="LanguageSelector"
                      AutomationProperties.Name="{loc:Loc Settings.Language.Automation}" />
            <TextBlock Text="{loc:Loc Settings.Language.Description}"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Settings.Appearance}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox x:Name="ThemeSelector"
                      Width="180"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource ThemeComboBoxStyle}"
                      SelectionChanged="OnThemeSelectionChanged"
                      AutomationProperties.AutomationId="ThemeSelector"
                      AutomationProperties.Name="{loc:Loc Settings.Theme}" />
            <TextBlock Text="{loc:Loc Settings.ThemeHint}"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Settings.Startup}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <CheckBox x:Name="StartupCheckBox"
                      Margin="0,8,0,0"
                      Content="{loc:Loc Settings.StartupCheckbox}"
                      FontSize="13"
                      Style="{StaticResource ThemeCheckBoxStyle}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="OnStartupOptionChanged"
                      Unchecked="OnStartupOptionChanged"
                      AutomationProperties.AutomationId="StartupWithWindows"
                      AutomationProperties.Name="{loc:Loc Settings.StartupAutomation}" />
            <TextBlock Text="{loc:Loc Settings.StartupHint}"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="StartupStatusText"
                       Margin="0,5,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Settings.Hotkey}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="EffectiveText"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SavedText"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Margin="0,3,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Settings.Hotkey.New}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="CaptureButton"
                    Height="46"
                    Margin="0,6,0,0"
                    Padding="12,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource HotkeyCaptureButtonStyle}"
                    Click="OnCaptureClick"
                    AutomationProperties.AutomationId="HotkeyCapture"
                    AutomationProperties.Name="{loc:Loc Settings.Hotkey.CaptureAutomation}">
                <TextBlock x:Name="CaptureText"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <TextBlock Text="{loc:Loc Settings.Hotkey.Hint}"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="{loc:Loc Settings.Hotkey.Manual}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ManualGestureBox"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         Style="{StaticResource ThemeTextBoxStyle}"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         KeyDown="OnManualKeyDown"
                         AutomationProperties.AutomationId="HotkeyManualInput"
                         AutomationProperties.Name="{loc:Loc Settings.Hotkey.ManualAutomation}" />
                <Button x:Name="ApplyManualButton"
                        Grid.Column="1"
                        Content="{loc:Loc Settings.Hotkey.Apply}"
                        Margin="8,0,0,0"
                        MinWidth="56"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnApplyManualClick"
                        AutomationProperties.AutomationId="HotkeyManualApply" />
            </Grid>
        </StackPanel>

        <CheckBox x:Name="SelectSearchTextCheckBox"
                  Grid.Row="6"
                  Margin="0,16,0,0"
                  Content="{loc:Loc Settings.SelectSearchText}"
                  FontSize="12"
                  Style="{StaticResource ThemeCheckBoxStyle}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  AutomationProperties.AutomationId="SelectSearchTextOnActivate"
                  AutomationProperties.Name="{loc:Loc Settings.SelectSearchTextAutomation}" />

        <StackPanel Grid.Row="7" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Settings.Data}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Loc Settings.Data.Current}"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StoragePathBox"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         HorizontalScrollBarVisibility="Auto"
                         Style="{StaticResource ThemeTextBoxStyle}"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         AutomationProperties.AutomationId="DataDirectoryPath"
                         AutomationProperties.Name="{loc:Loc Settings.Data.CurrentAutomation}" />
                <Button x:Name="StorageChangeButton"
                        Grid.Column="1"
                        Content="{loc:Loc Settings.Data.Change}"
                        Margin="8,0,0,0"
                        MinWidth="72"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnStorageClick"
                        AutomationProperties.AutomationId="ChangeDataDirectory"
                        AutomationProperties.Name="{loc:Loc Settings.Data.ChangeAutomation}" />
            </Grid>
            <TextBlock x:Name="StorageHintText"
                       Margin="0,7,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="8"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" />

        <Grid Grid.Row="9" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="RestoreDefaultButton"
                    Content="{loc:Loc Settings.RestoreDefaults}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="84"
                    Click="OnRestoreDefaultClick" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="{loc:Loc Settings.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="72"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button x:Name="SaveButton"
                        Content="{loc:Loc Settings.Save}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>